{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkillTopo",
  "version": "0.1.0",
  "identifier": "com.skilltopo.desktop",
  "build": { "frontendDist": "../frontend/dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "title": "SkillTopo", "width": 1600, "height": 960,
      "minWidth": 1000, "minHeight": 700, "decorations": true,
      "backgroundColor": "#0b1523", "center": true
    }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'" }
  },
  "bundle": { "active": false }
}
